#cloud-config
package_update: true
package_upgrade: true

packages:
  - curl
  - ca-certificates

write_files:
  - path: /usr/local/bin/setup-jumpserver.sh
    owner: root:root
    permissions: '0750'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      LOG=/var/log/jumpserver-setup.log
      exec > >(tee -a "$${LOG}") 2>&1

      DONE_MARKER=/var/lib/jumpserver-setup.done

      if [[ -f "$${DONE_MARKER}" ]]; then
        echo "[$(date -u)] JumpServer setup already completed, skipping"
        exit 0
      fi

      echo "[$(date -u)] Démarrage setup JumpServer node: ${node_name}"

      # ── 1. Installer Docker ─────────────────────────────────────────────────
      if ! command -v docker &>/dev/null; then
        curl -fsSL https://get.docker.com | bash
        systemctl enable --now docker
      fi

      # ── 2. Attendre PostgreSQL ──────────────────────────────────────────────
      echo "[$(date -u)] Attente PostgreSQL ${db_host}:${db_port}..."
      for i in $(seq 1 90); do
        if bash -c "echo >/dev/tcp/${db_host}/${db_port}" 2>/dev/null; then
          echo "[$(date -u)] PostgreSQL accessible"
          break
        fi
        if [[ $${i} -eq 90 ]]; then
          echo "[$(date -u)] ERREUR: PostgreSQL inaccessible" >&2
          exit 1
        fi
        sleep 5
      done

      # ── 3. Attendre Redis ───────────────────────────────────────────────────
      echo "[$(date -u)] Attente Redis ${redis_host}:${redis_port}..."
      for i in $(seq 1 30); do
        if bash -c "echo >/dev/tcp/${redis_host}/${redis_port}" 2>/dev/null; then
          echo "[$(date -u)] Redis accessible"
          break
        fi
        sleep 3
      done

      # ── 4. Pré-écrire config.txt avant installation ─────────────────────────
      mkdir -p /opt/jumpserver/config

      cat > /opt/jumpserver/config/config.txt <<EOF
      VOLUME_DIR=/data/jumpserver
      DB_ENGINE=postgresql
      DB_HOST=${db_host}
      DB_PORT=${db_port}
      DB_USER=${db_user}
      DB_PASSWORD=${db_password}
      DB_NAME=${db_name}
      REDIS_HOST=${redis_host}
      REDIS_PORT=${redis_port}
      REDIS_PASSWORD=${redis_password}
      HTTP_PORT=80
      SSH_PORT=2222
      LOG_LEVEL=INFO
      EOF

      # ── 5. Lancer installation officielle ──────────────────────────────────
      echo "[$(date -u)] Lancement quick_start.sh..."
      curl -sSL https://github.com/jumpserver/jumpserver/releases/latest/download/quick_start.sh \
        | bash

      mkdir -p /var/lib
      touch "$${DONE_MARKER}"

      echo "[$(date -u)] Installation terminée: ${node_name}"

  - path: /etc/systemd/system/jumpserver-setup.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Setup JumpServer
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/bin/setup-jumpserver.sh
      TimeoutStartSec=1800
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now jumpserver-setup.service
  - echo "${node_name}" > /etc/jumpserver-node-name
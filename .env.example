# ================================================================================
# Configuration - Auto-Sync JumpServer
# ================================================================================
# IMPORTANT: Dupliquez ce fichier en .env et remplissez les valeurs
# Ne jamais committer .env dans git!
# ================================================================================

# TOKEN HETZNER CLOUD
# Générer: https://console.hetzner.cloud/account/api-tokens
HETZNER_TOKEN=votre_token_hetzner_ici

# URL JUMPSERVER  
# Format: http://IP_ou_domaine (sans trailing slash)
JUMPSERVER_URL=http://ip de jumpserver

# TOKEN JUMPSERVER
# Générer: JumpServer UI → Settings → Auth Token
JUMPSERVER_TOKEN=votre_token_jumpserver_ici
